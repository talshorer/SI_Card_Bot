{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card.schema.json",
  "title": "Card",
  "description": "A power, fear, event or blight card. data/cards.json is an array of these. Images come from SICK, at https://sick.oberien.de/imgs/<powers|fears|events|blights>/<sickSlug>.webp. A unique power's spirit is recorded on that spirit's `uniques`, not here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "type", "sickSlug"],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "description": "Printed card name.",
      "$ref": "common.schema.json#/$defs/text"
    },
    "type": {
      "enum": ["unique", "minor", "major", "fear", "event", "blight"]
    },
    "sickSlug": {
      "$ref": "common.schema.json#/$defs/sickSlug"
    },
    "levels": {
      "description": "Fear card effects for terror levels I, II and III.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/text"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "aliases": {
      "description": "Other names the card is searched by, e.g. the titles of an event card's sub-events.",
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/sickSlug"
      },
      "uniqueItems": true
    },
    "stillHealthy": {
      "description": "Blight cards: true for a 'Still-Healthy Island' card, false for 'Blighted Island'.",
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "fear"
          }
        }
      },
      "then": {
        "required": ["levels"]
      },
      "else": {
        "not": {
          "required": ["levels"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "blight"
          }
        }
      },
      "then": {
        "required": ["stillHealthy"]
      },
      "else": {
        "not": {
          "required": ["stillHealthy"]
        }
      }
    }
  ]
}
