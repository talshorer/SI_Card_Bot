# Discord API token
DISCORD_TOKEN=
# the bot application's client ID, from the Discord developer portal.
# Only needed by `npm run commands:deploy`; the bot registers its own
# slash commands on startup without it.
DISCORD_CLIENT_ID=
# register slash commands to this one server instead of globally. Guild
# registrations show up straight away where global ones can take up to an
# hour, so set this while developing and leave it blank in production.
DISCORD_GUILD_ID=
# which port is exposed for Uptime Kuma (i.e. 3000)
HEALTH_PORT=
# used to specify which version of the bot is running locally
# for local dev, set it to si-card-bot:latest
IMAGE_URI=
# shared secret the deploy pipeline sends when it calls /webhook/deploy to
# announce a new release's changes to every server the bot is in. Must
# match the DEPLOY_WEBHOOK_SECRET GitHub Actions secret. Leave blank to
# disable the endpoint.
DEPLOY_WEBHOOK_SECRET=
# Cloudflare R2 bucket the card and panel images are served from. Only
# needed by `npm run assets:upload`. Create an API token under R2 → Manage
# R2 API Tokens with Object Read & Write on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# public url the bucket is served at, without a trailing slash
R2_PUBLIC_URL=https://cdn.callofthedahanways.com
